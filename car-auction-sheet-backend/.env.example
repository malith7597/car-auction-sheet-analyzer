# AuctionInsightAI — Spring Boot API environment template.
#
# Copy to `.env` (gitignored) for local dev. The app FAILS FAST on startup if any of the six
# mandatory variables below is missing or blank, naming the offending variable.

# ─────────────────────────────────────────────────────────────────────────────
# Mandatory — validated at startup (RequiredEnvironmentValidator). Boot fails without these.
# ─────────────────────────────────────────────────────────────────────────────

# Datasource — defaults match docker-compose.yml (postgres:15). Flyway runs against this on boot.
DB_URL=jdbc:postgresql://localhost:5432/auctioninsight
DB_USERNAME=auctioninsight
DB_PASSWORD=auctioninsight

# AWS region. Placeholder is fine for FS-001 boot; real value is decided before the first
# AWS-touching slice (FS-006 SQS / FS-010 S3). See architecture.md §Open Questions.
AWS_REGION=us-east-1

# JWT RS256 key pair — base64-encoded PEM. Consumed by FS-008 auth (private signs, public verifies).
# Replace with real base64-encoded keys; the placeholders below only let the shell boot.
JWT_PRIVATE_KEY=cGxhY2Vob2xkZXItcHJpdmF0ZS1rZXk=
JWT_PUBLIC_KEY=cGxhY2Vob2xkZXItcHVibGljLWtleQ==

# ─────────────────────────────────────────────────────────────────────────────
# Consumed by later slices — documented here for the full contract; not validated yet.
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth 2.0 (FS-008)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS credentials (local dev only; prod uses an IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Messaging / storage (FS-006 SQS, FS-010 S3)
SQS_ANALYSIS_QUEUE_URL=
S3_BUCKET_NAME=

# FastAPI worker gRPC (FS-007)
WORKER_GRPC_HOST=localhost
WORKER_GRPC_PORT=50051

# CORS — comma-separated allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
